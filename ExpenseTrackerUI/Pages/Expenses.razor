@page "/"
@rendermode InteractiveServer
@using ExpenseTrackerUI.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject IExpenseService Service
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Expense Tracker - Dashboard</PageTitle>

<!-- Header Section -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">
            <span class="text-gradient">💰 Expense Tracker</span>
        </h2>
        <p class="mb-0" style="color: var(--text-secondary);">Welcome, @userDisplayName (@userEmail)</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="theme-toggle" @onclick="ToggleDarkMode" title="Toggle dark mode">
            <i class="bi bi-@(isDarkMode ? "sun-fill" : "moon-stars-fill")"></i>
        </button>
        <a href="/api/auth/logout" class="theme-toggle" title="Sign out">
            <i class="bi bi-box-arrow-right"></i>
        </a>
    </div>
</div>

<!-- Toast Notifications (fixed position, no page scroll) -->
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="toast-notification toast-error">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        <button type="button" class="btn-close btn-close-white ms-3" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="toast-notification toast-success">
        <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        <button type="button" class="btn-close btn-close-white ms-3" @onclick="() => successMessage = null"></button>
    </div>
}

@if (isLoading)
{
    <!-- Loading Skeletons -->
    <div class="row g-3 mb-4">
        @for (int i = 0; i < 4; i++)
        {
            <div class="col-12 col-sm-6 col-lg-3">
                <LoadingSkeleton Type="stat-card" />
            </div>
        }
    </div>
}
else
{
    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <StatCard Label="Total Spent" 
                      Value="@totalSpent" 
                      IconClass="bi bi-wallet2" 
                      ColorClass="primary" />
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <StatCard Label="Average" 
                      Value="@averageExpense" 
                      IconClass="bi bi-graph-up-arrow" 
                      ColorClass="success" />
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <StatCard Label="Highest" 
                      Value="@highestExpense" 
                      IconClass="bi bi-arrow-up-circle" 
                      ColorClass="danger" />
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <StatCard Label="Total Items" 
                      Value="@expenses.Count.ToString()" 
                      IconClass="bi bi-receipt" 
                      ColorClass="warning" />
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-6">
            <!-- Category Summary -->
            <div class="modern-card h-100">
                <div class="modern-card-header">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-pie-chart-fill me-2"></i>Spending by Category
                    </h5>
                </div>
                <div class="modern-card-body">
                    @if (expenses.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var cat in expenses.GroupBy(e => e.Category).OrderByDescending(g => g.Sum(e => e.Amount)))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0 border-0" style="background: transparent;">
                                    <span class="expense-category-badge category-@cat.Key.ToLower()">
                                        <i class="bi bi-@GetCategoryIcon(cat.Key) me-1"></i>@cat.Key
                                    </span>
                                    <span class="flex-grow-1 mx-2" style="border-bottom: 2px dashed var(--text-secondary); height: 1px; align-self: center;"></span>
                                    <span class="fw-bold">@FormatINR(cat.Sum(e => e.Amount))</span>
                                </div>
                            }
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="fw-semibold">Total Expense</span>
                            <span class="flex-grow-1 mx-2" style="border-bottom: 2px dashed var(--text-secondary); height: 1px; align-self: center;"></span>
                            <span class="fw-bold fs-5 text-primary">@FormatINR(expenses.Sum(e => e.Amount))</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-pie-chart display-1"></i>
                            <p class="mt-3">No data to display</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <!-- Add Expense Form Card -->
            <div class="modern-card h-100">
                <div class="modern-card-header">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-plus-circle-fill me-2"></i>Add New Expense
                    </h5>
                </div>
                <div class="modern-card-body">
                    <div class="modern-form-group">
                        <i class="input-icon bi bi-card-heading"></i>
                        <input class="modern-input" 
                               placeholder="Expense title" 
                               @bind="newExpense.Title" />
                    </div>

                    <div class="modern-form-group">
                        <i class="input-icon bi bi-currency-rupee"></i>
                        <input class="modern-input" 
                               type="number" 
                               step="0.01"
                               placeholder="Amount in ₹" 
                               @bind="newExpense.Amount" />
                    </div>

                    <div class="modern-form-group">
                        <i class="input-icon bi bi-tag-fill"></i>
                        <select class="modern-select" @bind="newExpense.Category">
                            <option value="">Select Category</option>
                            <option>Food</option>
                            <option>Travel</option>
                            <option>Bills</option>
                            <option>Entertainment</option>
                            <option>Shopping</option>
                            <option>Other</option>
                        </select>
                    </div>

                    <button class="btn btn-gradient-primary w-100" 
                            @onclick="AddExpense"
                            disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Adding...</span>
                        }
                        else
                        {
                            <i class="bi bi-plus-lg me-2"></i>
                            <span>Add Expense</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Expense List -->
<div class="modern-card">
    <div class="modern-card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-semibold">
            <i class="bi bi-list-ul me-2"></i>Recent Expenses
        </h5>
        <div class="modern-form-group mb-0" style="max-width: 300px;">
            <i class="input-icon bi bi-search"></i>
            <input class="modern-input" 
                   placeholder="Search expenses..." 
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>
    </div>
    <div class="modern-card-body">
        @if (isLoading)
        {
            @for (int i = 0; i < 3; i++)
            {
                <LoadingSkeleton Type="expense-item" />
            }
        }
        else if (!FilteredExpenses.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <p class="text-muted mt-3">No expenses found</p>
                <p class="text-muted small">Start by adding your first expense above</p>
            </div>
        }
        else
        {
            <div class="expense-list" style="max-height: 400px; overflow-y: auto;">
                @foreach (var exp in FilteredExpenses)
                {
                    <div class="expense-item slide-in">
                        <div class="d-flex align-items-center" style="width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, rgba(6, 182, 212, 0.2) 0%, rgba(59, 130, 246, 0.2) 100%); justify-content: center;">
                            <i class="bi bi-@GetCategoryIcon(exp.Category) text-primary" style="font-size: 20px;"></i>
                        </div>

                        <div class="flex-grow-1">
                            <div class="fw-semibold">@exp.Title</div>
                            <div class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i>@exp.Date.ToString("MMM dd, yyyy")
                            </div>
                        </div>

                        <div class="text-end me-3">
                            <div class="fw-bold" style="font-size: 1.125rem;">@FormatINR(exp.Amount)</div>
                            <span class="expense-category-badge category-@exp.Category.ToLower()">
                                @exp.Category
                            </span>
                        </div>

                        <button class="btn btn-gradient-danger btn-icon" 
                                @onclick="() => ShowDeleteConfirmation(exp.Id)"
                                @onclick:stopPropagation="true"
                                title="Delete expense">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal (inline to avoid child component render issues) -->
@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 9999;" @onclick="CancelDelete">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content modern-card">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                        Confirm Delete
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Are you sure you want to delete this expense? This action cannot be undone.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">
                        <i class="bi bi-x-lg me-1"></i> No
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
                        <i class="bi bi-trash3 me-1"></i> Yes, Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Expense> expenses = new();
    private Expense newExpense = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isDarkMode = false;
    private string searchTerm = string.Empty;
    private string userEmail = string.Empty;
    private string userDisplayName = string.Empty;

    // Delete confirmation
    private bool showDeleteModal = false;
    private int expenseToDelete = 0;

    // Statistics with INR formatting
    private string totalSpent => FormatINR(expenses.Sum(e => e.Amount));
    private string averageExpense => FormatINR(expenses.Any() ? expenses.Average(e => e.Amount) : 0);
    private string highestExpense => FormatINR(expenses.Any() ? expenses.Max(e => e.Amount) : 0);

    // Helper method for INR formatting
    private string FormatINR(decimal amount)
    {
        // Use explicit rupee symbol and Indian number formatting
        return $"₹{amount:N2}";
    }

    // Filtered expenses based on search
    private IEnumerable<Expense> FilteredExpenses => 
        string.IsNullOrWhiteSpace(searchTerm) 
            ? expenses.OrderByDescending(e => e.Date)
            : expenses.Where(e => 
                e.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                e.Category.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
              ).OrderByDescending(e => e.Date);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
        userDisplayName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? userEmail;

        if (string.IsNullOrEmpty(userEmail))
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadExpenses();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("initializeTheme");
            isDarkMode = theme == "dark";
            StateHasChanged();
        }
    }

    private async Task LoadExpenses()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            expenses = await Service.GetExpenses(userEmail) ?? new List<Expense>();

            // Force UI update after loading
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading expenses: {ex.Message}");
            errorMessage = $"Failed to load expenses: {ex.Message}";
            expenses = new List<Expense>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddExpense()
    {
        if (string.IsNullOrWhiteSpace(newExpense.Title))
        {
            errorMessage = "Please enter a title";
            return;
        }

        if (newExpense.Amount <= 0)
        {
            errorMessage = "Please enter a valid amount";
            return;
        }

        if (string.IsNullOrWhiteSpace(newExpense.Category))
        {
            errorMessage = "Please select a category";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await Service.AddExpense(newExpense, userEmail);
            await LoadExpenses();

            successMessage = $"✅ Successfully added '{newExpense.Title}'";
            newExpense = new Expense();

            // Clear success message after 3 seconds
            _ = Task.Delay(3000).ContinueWith(_ => 
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to add expense: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Task ShowDeleteConfirmation(int id)
    {
        expenseToDelete = id;
        showDeleteModal = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ConfirmDelete()
    {
        showDeleteModal = false;
        errorMessage = null;
        successMessage = null;

        try
        {
            Console.WriteLine($"Attempting to delete expense ID: {expenseToDelete}");
            await Service.DeleteExpense(expenseToDelete, userEmail);
            Console.WriteLine("Delete request completed");

            // Reload expenses to reflect the deletion
            await LoadExpenses();

            successMessage = "✅ Expense deleted successfully";

            _ = Task.Delay(3000).ContinueWith(_ => 
            {
                successMessage = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (HttpRequestException httpEx)
        {
            Console.WriteLine($"HTTP error during delete: {httpEx.Message}");
            errorMessage = $"Failed to delete expense: Network error - {httpEx.Message}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during delete: {ex.Message}");
            errorMessage = $"Failed to delete expense: {ex.Message}";
        }
    }

    private Task CancelDelete()
    {
        showDeleteModal = false;
        expenseToDelete = 0;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ToggleDarkMode()
    {
        var newTheme = await JS.InvokeAsync<string>("toggleDarkMode");
        isDarkMode = newTheme == "dark";
    }

    private string GetCategoryIcon(string category) => category?.ToLower() switch
    {
        "food" => "cup-hot-fill",
        "travel" => "airplane-fill",
        "bills" => "receipt-cutoff",
        "entertainment" => "controller",
        "shopping" => "bag-fill",
        _ => "cash-coin"
    };
}
