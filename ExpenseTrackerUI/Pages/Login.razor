@page "/login"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Sign In - Expense Tracker</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-logo">💰</div>
            <h2 class="fw-bold mb-1">Expense Tracker</h2>
            <p class="text-muted">@(isRegisterMode ? "Create your account" : "Sign in to manage your finances")</p>
        </div>

        <div class="login-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 px-3 mb-3" role="alert">
                    <i class="bi bi-exclamation-circle me-1"></i> @errorMessage
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="HandleSubmit" FormName="loginForm">
                @if (isRegisterMode)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <InputText @bind-Value="model.Name" class="form-control" placeholder="Your full name" />
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <InputText @bind-Value="model.Email" class="form-control" placeholder="you@example.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <InputText @bind-Value="model.Password" type="password" class="form-control" placeholder="Enter your password" />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    @(isRegisterMode ? "Create Account" : "Sign In")
                </button>
            </EditForm>

            <div class="text-center mt-3">
                <button class="btn btn-link text-decoration-none" @onclick="ToggleMode">
                    @(isRegisterMode ? "Already have an account? Sign In" : "Don't have an account? Register")
                </button>
            </div>

            <div class="login-features mt-3">
                <div class="feature-item">
                    <i class="bi bi-shield-check"></i>
                    <span>Password encrypted and secure</span>
                </div>
                <div class="feature-item">
                    <i class="bi bi-cloud-check"></i>
                    <span>Data synced to your account</span>
                </div>
                <div class="feature-item">
                    <i class="bi bi-phone"></i>
                    <span>Access from anywhere</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel model = new();
    private bool isRegisterMode = false;
    private bool isLoading = false;
    private string? errorMessage;

    private void ToggleMode()
    {
        isRegisterMode = !isRegisterMode;
        errorMessage = null;
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            var endpoint = isRegisterMode ? "/api/auth/register" : "/api/auth/login";

            var result = await JS.InvokeAsync<LoginResult>("performLogin", endpoint, model.Email, model.Password, isRegisterMode ? model.Name : null);

            if (result.Success)
            {
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                errorMessage = result.Message ?? "Something went wrong. Please try again.";
            }
        }
        catch
        {
            errorMessage = "Unable to connect. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class LoginResult
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
    }

    private class LoginModel
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        padding: 1rem;
    }

    .login-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        width: 100%;
        max-width: 420px;
        overflow: hidden;
    }

    .login-header {
        text-align: center;
        padding: 2.5rem 2rem 1.5rem;
        background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
        color: white;
    }

    .login-header p {
        color: rgba(255,255,255,0.8) !important;
    }

    .login-logo {
        font-size: 3rem;
        margin-bottom: 0.5rem;
    }

    .login-body {
        padding: 2rem;
    }

    .login-features {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: #6b7280;
        font-size: 0.9rem;
    }

    .feature-item i {
        color: #10b981;
        font-size: 1.1rem;
    }
</style>
