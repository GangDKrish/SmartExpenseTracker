@* Loading Skeleton for Better UX *@

@if (Type == "stat-card")
{
    <div class="stat-card">
        <div class="skeleton" style="width: 48px; height: 48px; border-radius: 0.5rem; margin-bottom: 1rem;"></div>
        <div class="skeleton skeleton-text" style="width: 60%;"></div>
        <div class="skeleton" style="width: 80%; height: 2rem; margin: 0.5rem 0;"></div>
        <div class="skeleton skeleton-text" style="width: 40%;"></div>
    </div>
}
else if (Type == "expense-item")
{
    <div class="expense-item">
        <div class="skeleton" style="width: 40px; height: 40px; border-radius: 50%;"></div>
        <div style="flex: 1;">
            <div class="skeleton skeleton-title"></div>
            <div class="skeleton skeleton-text" style="width: 40%;"></div>
        </div>
        <div class="skeleton" style="width: 80px; height: 32px;"></div>
    </div>
}
else if (Type == "chart")
{
    <div class="chart-container">
        <div class="skeleton skeleton-card"></div>
    </div>
}
else
{
    <!-- Default skeleton -->
    <div class="skeleton skeleton-card"></div>
}

@code {
    [Parameter]
    public string Type { get; set; } = "default";  

    [Parameter]
    public int Count { get; set; } = 1;
}
